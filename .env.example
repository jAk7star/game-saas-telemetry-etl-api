# Configuração de Banco de Dados (SQLite local por padrão ou PostgreSQL em produção)
DATABASE_URL=sqlite:///./telemetry_warehouse.db
# Exemplo PostgreSQL: DATABASE_URL=postgresql+psycopg2://telemetry_user:telemetry_pass@db:5432/telemetry_dw

# Segredo criptográfico (Salt) para hash determinístico Zero-Exposure (LGPD)
ZERO_EXPOSURE_SALT=antigravity-lgpd-zero-exposure-salt-2026

# Configurações da API
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Configuração Firebase Cloud Firestore (Dual-Mode: Cloud SDK ou Simulador In-Memory)
# Deixe em branco para usar automaticamente o In-Memory Firestore Simulator (Zero-Config para testes/Swagger)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIRESTORE_EMULATOR_HOST=
FIRESTORE_COLLECTION_NAME=telemetry_raw_events

